---
import fs from 'node:fs';
import path from 'node:path';
// import alertsData from './alerts.json';

// Defines the allowed AlertTypes
type AlertType = 'info' | 'success' | 'warning' | 'error';

interface Alert {
    message: string;
    type?: AlertType;
    dismissible?: boolean;
}

const styles: Record<AlertType, { bg: string; text: string }> = {
    info: { bg: 'lightblue', text: 'darkblue' },
    success: { bg: '#d1fae5', text: '#065f46' },
    warning: { bg: '#fef3c7', text: '#92400e' },
    error: { bg: '#fee2e2', text: '#991b1b' },
};

let alerts: Alert[] = [];

try {
    const filePath = path.resolve('./src/components/Alert/alerts.json');

    if (fs.existsSync(filePath)) {
        const fileContent = fs.readFileSync(filePath, 'utf-8');

        alerts = JSON.parse(fileContent);
    } else {
        console.warn(`Alerts file not found at: ${filePath}`);
    }
} catch (error) {
    console.error('Error reading or parsing alerts.json:', error);
}

const hasAlerts = alerts && alerts.length > 0;
---

{hasAlerts && (
    <div style="display: block !important; width: 100% !important;">
        <section 
            class="alert-list max-w-xl mx-auto p-4 flex flex-col gap-3" 
            style="display: flex !important; flex-direction: column !important; gap: 12px !important; margin: 0 auto !important;"
        >
            {alerts.map((alert) => {
                const config = styles[alert.type ?? "info"];
                const isDismissible = alert.dismissible ?? false; 

                return (
                    <div
                        data-alert-behavior={isDismissible ? "manual" : "auto"}
                        class="alert rounded font-medium text-sm border border-black/5 transition-opacity duration-500 ease-in-out"
                        style={`position: relative !important; padding: 16px 48px 16px 16px !important; background-color: ${config.bg}; color: ${config.text}; display: block !important;`}
                    >
                        <p class="m-0 leading-relaxed" style="margin: 0; padding: 0; text-align: left;">
                            {alert.message}
                        </p>

                        {isDismissible && (
                            <button 
                                type="button" 
                                data-dismiss-btn
                                aria-label="Dismiss alert"
                                style="position: absolute !important; top: 8px !important; right: 8px !important; height: 16px !important; width: 16px !important; padding: 0 !important; margin: 0 !important; background: transparent !important; border: none !important; cursor: pointer !important; display: flex !important; align-items: center !important; justify-content: center !important; min-width: 16px !important; min-height: 16px !important; box-shadow: none !important; z-index: 10 !important;"
                                class="hover:bg-black/10 rounded-md transition-colors"
                            >
                                <svg 
                                    style={`width: 10px !important; height: 10px !important; min-width: 10px !important; min-height: 10px !important; display: block !important; color: ${config.text} !important; fill: none !important; margin: -4px 0 0 0 !important; padding: 0 !important;`} 
                                    aria-hidden="true" 
                                    xmlns="http://www.w3.org/2000/svg" 
                                    viewBox="0 0 14 14"
                                >
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                                </svg>
                            </button>
                        )}
                    </div>
                );
            })}
        </section>

        <div style="clear: both !important; display: block !important; height: 24px !important; min-height: 24px !important; width: 100% !important;"></div>
    </div>
)}

<script>
    const removeAlert = (element: Element) => {
        element.classList.add('fade-out');
        setTimeout(() => {
            element.remove();
        }, 500);
    };

    const alerts = document.querySelectorAll('[data-alert-behavior]')

    alerts.forEach(alert => {
        const behavior = alert.getAttribute('data-alert-behavior');
        if (behavior === 'manual') {
            const dismissBtn = alert.querySelector('[data-dismiss-btn]');
            dismissBtn?.addEventListener('click', () => removeAlert(alert));
        } else if (behavior === 'auto') {
            setTimeout(() => removeAlert(alert), 5000);
        }
    });
</script>